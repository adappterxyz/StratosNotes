{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stratosnotes",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/ = the landing page at /, the app under /app/ (npm run build).
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/app", "/app/*"]
  },
  "routes": [{ "pattern": "sp.stratoslab.app", "custom_domain": true }],
  // Kept so old stratosnotes.<account>.workers.dev links redirect to sp.stratoslab.app.
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "FAUCET", "id": "c1569994e667444a93855abd7b87f43a" }],
  "vars": {
    "TEST_USDC": "ATn589uY1YL3o7Bz1E3NBguissueVKtQD2tcbHDyNnB6",
    "TEST_USDC_MINT_MULTISIG": "BSWQ6qPYS54KDHW2v5uJBxRNTRYgpJ7eLfBHz2mwAC9n"
  }
  // Secret: FAUCET_KEY (the test mint's authority, devnet only) — wrangler secret put FAUCET_KEY
}
